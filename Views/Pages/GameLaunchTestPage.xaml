<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamCNGameLauncher.Views.Pages.GameLaunchTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="820" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="从 Steam 开始游戏" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="游戏将由 Steam 按 AppID 启动，并由 Steam 跟踪对应的游戏中状态。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <InfoBar x:Name="statusInfoBar" IsOpen="True" IsClosable="False"
                     Severity="Informational" Title="正在检查" Message="请选择需要启动的游戏。"/>

            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="启动设置" FontSize="18" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbGames" Header="选择已添加的游戏"
                              PlaceholderText="暂无可启动的游戏"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              SelectionChanged="Game_SelectionChanged"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Steam AppID" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="txtAppId" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="真实游戏 EXE" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="txtGameExe" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                    </Grid>
                    <Button x:Name="btnRefresh" Content="重新检查启动条件"
                            HorizontalAlignment="Stretch" Click="Refresh_Click"/>
                    <Button x:Name="btnLaunch" Content="开始游戏"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Padding="20,10"
                            Click="Launch_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="使用前须知" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="请先生成该游戏的 ACF、重启并登录 Steam，再把游戏配置页生成的命令填写到 Steam 启动选项。本页只请求 Steam 启动对应 AppID，不会直接运行真实游戏 EXE，也不会读取或修改登录凭据。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
