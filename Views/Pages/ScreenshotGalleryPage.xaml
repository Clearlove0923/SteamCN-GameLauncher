<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SteamCNGameLauncher.Views.Pages.ScreenshotGalleryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppearancePageBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Padding="28,24" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="截图" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="浏览和管理不同游戏的 Steam 截图" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <ComboBox x:Name="GameSelector" Grid.Column="1" Header="游戏" MinWidth="220" IsEnabled="False"/>
            <ComboBox Grid.Column="2" Header="排序" Width="150" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="最新优先"/><ComboBoxItem Content="最早优先"/></ComboBox>
        </Grid>
        <Grid Grid.Row="1" Padding="28,8,28,28">
            <GridView IsItemClickEnabled="False" Opacity="0.55">
                <GridView.Items>
                    <GridViewItem><Border Width="280" Height="158" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12"><FontIcon Glyph="&#xEB9F;" FontSize="36"/></Border></GridViewItem>
                    <GridViewItem><Border Width="280" Height="158" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12"><FontIcon Glyph="&#xEB9F;" FontSize="36"/></Border></GridViewItem>
                    <GridViewItem><Border Width="280" Height="158" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12"><FontIcon Glyph="&#xEB9F;" FontSize="36"/></Border></GridViewItem>
                </GridView.Items>
            </GridView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xEB9F;" FontSize="44"/>
                <TextBlock Text="截图管理将在后续版本接入" FontSize="18" FontWeight="SemiBold"/>
                <Button Content="打开截图文件夹" HorizontalAlignment="Center" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
