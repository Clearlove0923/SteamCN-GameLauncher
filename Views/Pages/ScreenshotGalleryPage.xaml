<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SteamCNGameLauncher.Views.Pages.ScreenshotGalleryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppearancePageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="28,24" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="截图" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="浏览和管理截图"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <CalendarDatePicker x:Name="DateJumpPicker" Grid.Column="1" Header="日历"
                                Width="170" PlaceholderText="跳转到日期"
                                IsEnabled="False" DateChanged="DateJumpPicker_DateChanged"
                                CalendarViewDayItemChanging="DateJumpPicker_CalendarViewDayItemChanging"/>
            <ComboBox x:Name="GameSelector" Grid.Column="2" Header="游戏" MinWidth="220"
                      DisplayMemberPath="Name" SelectionChanged="GameSelector_SelectionChanged"/>
            <ComboBox x:Name="SortSelector" Grid.Column="3" Header="排序" Width="150"
                      SelectedIndex="0" SelectionChanged="SortSelector_SelectionChanged">
                <ComboBoxItem Content="最新优先"/>
                <ComboBoxItem Content="最早优先"/>
            </ComboBox>
            <Button x:Name="ChooseFolderButton" Grid.Column="4" Margin="0,24,0,0"
                    Height="32" Padding="12,0" Click="ChooseFolderButton_Click"
                    Content="选择文件夹"/>
        </Grid>

        <Grid Grid.Row="1" Padding="28,8,28,28">
            <GridView x:Name="ScreenshotGrid" IsItemClickEnabled="True" SelectionMode="None"
                      ItemClick="ScreenshotGrid_ItemClick"
                      SizeChanged="ScreenshotGrid_SizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="150"
                                       GroupPadding="0,0,0,18"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="GridViewHeaderItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateText}" FontSize="18"
                                           Margin="0,12,0,12"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="12">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="在文件夹中显示" Tag="{Binding}"
                                                    Click="ShowScreenshotInFolder_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="删除截图" Tag="{Binding}"
                                                    Click="DeleteScreenshot_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <FontIcon Glyph="&#xEB9F;" FontSize="36"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xEB9F;" FontSize="44"/>
                <TextBlock x:Name="EmptyStateTitle" Text="请选择截图文件夹"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyStateDetail" Text="选择后将显示该游戏目录中的截图"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="选择截图文件夹" HorizontalAlignment="Center"
                        Click="ChooseFolderButton_Click"/>
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Width="40" Height="40"
                          IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
