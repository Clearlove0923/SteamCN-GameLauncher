<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SteamCNGameLauncher.Views.Pages.LauncherHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:SteamCNGameLauncher.Views.Controls">
    <Grid Background="{StaticResource AppearancePageBackground}">
        <!-- 首页内容覆盖在全窗口背景上，位置按 1920×1080 米哈游启动器参考布局设置。 -->
        <!-- 资讯面板尺寸由 HomeLayoutProfile 控制，不同 Provider 可使用不同布局档案。 -->
        <Border x:Name="NewsPanel" Width="576" Height="425" Margin="90,0,0,76"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" CornerRadius="14">
            <controls:HomeBannerAndNews x:Name="HomeContentPanel"/>
        </Border>

        <!-- 时长入口与启动区共享右下角锚点。 -->
        <StackPanel x:Name="LaunchDock" Margin="0,0,90,90"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12">
            <Border x:Name="PlayTimeButtonBackground" Background="#18353941" CornerRadius="42"
                    PointerEntered="PlayTimeButton_PointerEntered"
                    PointerExited="PlayTimeButton_PointerExited">
                <Button x:Name="PlayTimeButton" Width="186" Height="84" Padding="0"
                        CornerRadius="42" Background="Transparent" Foreground="White"
                        BorderThickness="0" Click="PlayTimeButton_Click"
                        ToolTipService.ToolTip="查看游戏时长统计">
                    <StackPanel x:Name="PlayTimeButtonContent" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#18272B32">
                            <FontIcon x:Name="PlayTimeIcon" Glyph="&#xE916;" FontSize="18"
                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PlayTimeText" Text="0m" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
            <Border x:Name="LaunchButtonGroupBackground"
                    HorizontalAlignment="Right" Background="#18353941" CornerRadius="42"
                    PointerEntered="LaunchButtonGroup_PointerEntered"
                    PointerExited="LaunchButtonGroup_PointerExited">
            <StackPanel x:Name="LaunchButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                <Button x:Name="StartGameButton" Width="186" Height="84" CornerRadius="42"
                        Padding="0" Background="Transparent" Foreground="White" BorderThickness="0"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        IsEnabled="False" Click="StartGameButton_Click">
                    <Grid>
                        <!-- 独立背景层避免 WinUI 默认 PointerOver 状态覆盖自定义透明度。 -->
                        <Border x:Name="StartGameButtonBackground" Background="Transparent"
                                CornerRadius="42,0,0,42"/>
                        <StackPanel x:Name="StartGameButtonContent" Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#18272B32">
                                <FontIcon x:Name="StartGamePlayIcon" Glyph="&#xE768;" FontSize="18" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StartGameText" Text="开始游戏" FontSize="22" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="LaunchMenuButton" Width="93" Height="84" CornerRadius="42"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTipService.ToolTip="启动设置">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutSubItem Text="游戏启动方式">
                                <ToggleMenuFlyoutItem x:Name="DirectCnLaunchModeItem" Text="国服"
                                                      Click="LaunchModeMenuItem_Click"/>
                                <ToggleMenuFlyoutItem x:Name="SteamCnLaunchModeItem" Text="Steam 玩国服"
                                                      IsChecked="True" Click="LaunchModeMenuItem_Click"/>
                                <ToggleMenuFlyoutItem x:Name="SteamInternationalLaunchModeItem" Text="Steam 玩国际服"
                                                      Click="LaunchModeMenuItem_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="首页显示">
                                <ToggleMenuFlyoutItem x:Name="ShowHomeAnimationItem" Text="显示动画"
                                                      IsChecked="True" Click="HomeDisplayMenuItem_Click"/>
                                <ToggleMenuFlyoutItem x:Name="ShowHomeNewsItem" Text="显示资讯栏"
                                                      IsChecked="True" Click="HomeDisplayMenuItem_Click"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <Grid>
                        <FontIcon x:Name="LaunchMenuIcon" Width="36" Height="36"
                                  Glyph="&#xE713;" FontSize="26"
                                  Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
