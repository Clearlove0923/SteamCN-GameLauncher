<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamCNGameLauncher.Views.Pages.CustomManifestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="GameInfoCandidateTemplate">
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" MaxWidth="760"/>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Background="{StaticResource AppearancePageBackground}"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- Steam 配置页随主内容区伸展，不再保留旧标题栏和固定宽度留白。 -->
        <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Stretch">

            <!-- 全局配置缺失提示（OnLoaded 判定后切换可见性） -->
            <InfoBar x:Name="globalConfigInfoBar"
                     Severity="Warning"
                     Title="请先在「设置」中配置 Steam 全局参数"
                     Message="自定义 Manifest 页依赖 Steam 安装路径、SteamLibrary 路径、SteamID 三项。"
                     IsOpen="False"
                     IsClosable="False"/>

            <!-- 游戏配置管理 -->
            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="游戏配置" FontSize="16" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbPreset"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              SelectionChanged="Preset_SelectionChanged"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnNewPreset" Content="新建" Click="NewPreset_Click"/>
                        <Button Grid.Column="1" x:Name="btnRenamePreset" Content="重命名" Click="RenamePreset_Click"/>
                        <Button Grid.Column="2" x:Name="btnDeletePreset" Content="删除" Click="DeletePreset_Click"/>
                        <Button Grid.Column="3" x:Name="btnLaunchMode" Content="启动方式：Steam 玩国服">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <ToggleMenuFlyoutItem x:Name="ConfigDirectCnLaunchModeItem"
                                                          Text="国服"
                                                          Click="ConfigLaunchModeMenuItem_Click"/>
                                    <ToggleMenuFlyoutItem x:Name="ConfigSteamCnLaunchModeItem"
                                                          Text="Steam 玩国服" IsChecked="True"
                                                          Click="ConfigLaunchModeMenuItem_Click"/>
                                    <ToggleMenuFlyoutItem x:Name="ConfigSteamInternationalLaunchModeItem"
                                                          Text="Steam 玩国际服"
                                                          Click="ConfigLaunchModeMenuItem_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <!-- 常用配置操作并排放置，避免用户在页面上下寻找保存入口。 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnOneClickUpdate" Content="一键更新 Steam 配置"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="OneClickUpdate_Click"/>
                        <Button Grid.Column="1" x:Name="btnOpenLauncher" Content="打开游戏启动器"
                                HorizontalAlignment="Stretch" Click="OpenLauncher_Click"/>
                        <Button Grid.Column="2" x:Name="btnSave" Content="保存配置"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="Save_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Steam 启动配置：集中维护 App、Depot、Build 和 Manifest 标识。 -->
            <Border x:Name="SteamConfigCard" Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Steam 启动配置" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Text="AppID" FontWeight="Medium"/>
                            <TextBox x:Name="txtAppId" PlaceholderText="填写 AppID 后自动获取"/>
                            <Button x:Name="btnFetchGameInfo" Content="自动获取游戏信息"
                                    Click="FetchGameInfo_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Text="DepotID" FontWeight="Medium"/>
                            <TextBox x:Name="txtDepotId" PlaceholderText="例如 3513351"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <TextBlock Text="显示名称" FontWeight="Medium"/>
                            <TextBox x:Name="txtDisplayName" PlaceholderText="例如 Wuthering Waves"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="安装目录名" FontWeight="Medium"/>
                            <TextBox x:Name="txtInstallDir" PlaceholderText="例如 Wuthering Waves"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                            <TextBlock Text="语言代码（ACF UserConfig.language）" FontWeight="Medium"/>
                            <ComboBox x:Name="cmbLanguageCode" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="schinese" Content="schinese - 简体中文" IsSelected="True"/>
                                <ComboBoxItem Tag="tchinese" Content="tchinese - 繁體中文"/>
                                <ComboBoxItem Tag="english"  Content="english - English"/>
                                <ComboBoxItem Tag="japanese" Content="japanese - 日本語"/>
                                <ComboBoxItem Tag="koreana"  Content="koreana - 한국어"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <TextBlock Text="填写 AppID 后，点击上方“自动获取游戏信息”可一并获取公开分支的 BuildID 和 Manifest。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="BuildID" FontWeight="Medium"/>
                            <TextBox x:Name="txtBuildId" PlaceholderText="自动获取或手动填入"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Manifest" FontWeight="Medium"/>
                            <TextBox x:Name="txtManifest" PlaceholderText="自动获取或手动填入"/>
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="gameInfoStatus" IsOpen="False" IsClosable="False"/>
                    <ComboBox x:Name="cmbDepotCandidates" Header="选择 Depot"
                              PlaceholderText="请选择 Depot，也可手动填写 DepotID"
                              ItemTemplate="{StaticResource GameInfoCandidateTemplate}" HorizontalAlignment="Stretch"
                              Visibility="Collapsed" SelectionChanged="DepotCandidate_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Name="lnkGameConfig" Content="SteamDB 启动配置" IsEnabled="False"/>
                        <HyperlinkButton x:Name="lnkGameDepots" Content="SteamDB Depot 信息" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="提示：可在 "/>
                        <Run Text="steamdb.info/app/&lt;AppID&gt;/depots/" FontWeight="SemiBold"/>
                        <Run Text=" 查询任意 Steam 游戏的 AppID / DepotID。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 游戏可执行文件 -->
            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="游戏可执行文件" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtClientExePath"
                                 PlaceholderText="例如 D:\Games\xxx\Client-Win64-Shipping.exe"
                                 GotFocus="ClientExePath_GotFocus"/>
                        <Button Grid.Column="1" Content="浏览" Click="BrowseClientExe_Click"/>
                        <Button Grid.Column="2" Content="清除" Click="ClearClientExe_Click"/>
                    </Grid>
                    <TextBlock x:Name="ClientExecutableHint"
                               Text="提示：请选择国服游戏的真实可执行文件；该路径用于生成启动命令和直接启动国服。"
                               TextWrapping="Wrap"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="游戏启动器（可选）" FontWeight="Medium"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLauncherExePath"
                                     PlaceholderText="例如 D:\Games\xxx\launcher.exe"/>
                            <Button Grid.Column="1" Content="浏览" Click="BrowseLauncherExe_Click"/>
                            <Button Grid.Column="2" Content="清除" Click="ClearLauncherExe_Click"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="提示：该路径用于下方的「打开游戏启动器」功能，并会随当前游戏配置保存。"
                               TextWrapping="Wrap"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <StackPanel x:Name="SteamPlaceholderPanel" Spacing="6">
                        <TextBlock Text="Steam 占位文件名" FontWeight="Medium"/>
                        <TextBox x:Name="txtExecutableFileName"
                                 PlaceholderText="留空则用 &lt;显示名&gt;.exe"/>
                        <ComboBox x:Name="cmbExecutableCandidates" Header="选择启动文件"
                                  PlaceholderText="多个启动文件，请选择与 Steam 启动项对应的路径"
                                  ItemTemplate="{StaticResource GameInfoCandidateTemplate}" HorizontalAlignment="Stretch"
                                  Visibility="Collapsed" SelectionChanged="ExecutableCandidate_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="SteamPlaceholderHint"
                               Text="提示：该文件名须等于 Steam appinfo 登记的可执行文件名，否则 Steam 无法启动；它与上方的真实 EXE 路径是两个不同概念。"
                               TextWrapping="Wrap"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 特殊启动参数独立于文件路径配置，便于后续扩展启动方式。 -->
            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="特殊启动参数" FontSize="16" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtLaunchArguments"
                             Header="启动参数（可选）"
                             PlaceholderText="例如 -dx11；无需填写 %command%"/>
                    <TextBlock x:Name="LaunchArgumentsHint"
                               Text="提示：参数会插入真实 EXE 与 %command% 之间，并随当前游戏配置保存。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Spacing="8">
                <Button x:Name="btnGenerate"
                        Content="生成配置文件（appmanifest_&lt;AppID&gt;.acf）"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="Generate_Click"/>
                <Button x:Name="btnCopyCommand"
                        Content="复制启动命令到剪贴板"
                        HorizontalAlignment="Stretch"
                        Click="CopyCommand_Click"/>
            </StackPanel>

            <!-- 运行日志 -->
            <Border Background="{StaticResource AppearanceCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="清空" HorizontalAlignment="Right" Click="ClearLog_Click"/>
                    </Grid>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12" Height="200">
                        <ScrollViewer x:Name="logScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="logList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
