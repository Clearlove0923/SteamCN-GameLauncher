<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SteamCNGameLauncher</RootNamespace>
    <AssemblyName>SteamCN-GameLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <Nullable>enable</Nullable>
    <Version>2.6.1</Version>
    <Product>Steam国服游戏启动器</Product>
    <AssemblyTitle>Steam国服游戏启动器</AssemblyTitle>
    <Description>在 Steam 库中添加和管理国服游戏的启动配置</Description>
    <Company>Violet0923</Company>
    <ApplicationIcon>Assets\Icons\SteamCN-GameLauncher.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	<WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Output\**" />
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <ApplicationDefinition Remove="Tests\**" />
    <PRIResource Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="Output\**" />
    <None Remove="Output\**" />
    <Page Remove="Output\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="SteamCN-GameLauncher.iss" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Icons\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Icons\SteamCN-GameLauncher.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Backgrounds\default-black.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Embedded Python distribution (python-build-standalone 3.10.21 win-x64)。
    解压自 cpython-3.10.21+20260924-x86_64-pc-windows-msvc-install_only.tar.gz，
    落到 bin\python-runtime\。launcher 启动时 PythonWorkerSpawner 优先用本目录
    的 python.exe，让用户拷走整个 bin 就能跑（零外部 Python 依赖）。
    ~118 MB / 3932 文件，可压缩到 ~50 MB publish zip。
  -->
  <ItemGroup>
    <_EmbeddedPython Include="bin\python-runtime\**\*" />
  </ItemGroup>

  <!--
    Embedded Python distribution (python-build-standalone 3.10.21 win-x64) —
    解压自 cpython-3.10.21+20260924-x86_64-pc-windows-msvc-install_only.tar.gz，
    落到 bin\python-runtime\。launcher 启动时 PythonWorkerSpawner 优先用本目录
    的 python.exe，让用户拷走整个 bin 就能跑（零外部 Python 依赖）。
    ~118 MB / 3932 文件，可压缩到 ~50 MB publish zip。

    用 <_EmbeddedPython> + 自定义 <Target> 而不是 <Content>/<None>：
    WinUI3 SDK 的 PRI 生成器把 <Content> 当成语言限定符处理，<None> 默认不复制，
    二者都不稳；用 Copy task 在 Build 完成后显式复制最可控。
  -->
  <Target Name="CopyEmbeddedPython" AfterTargets="Build">
    <PropertyGroup>
      <_EmbeddedPythonOutDir>$(OutDir)</_EmbeddedPythonOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedPythonOutDir)python-runtime" Condition="!Exists('$(_EmbeddedPythonOutDir)python-runtime')" />
    <Copy SourceFiles="@(_EmbeddedPython)"
          DestinationFiles="@(_EmbeddedPython->'$(_EmbeddedPythonOutDir)python-runtime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3" />
  </Target>

  <!--
    publish 输出目录与 OutDir 不同（$(PublishDir) vs $(OutDir)），
    单独挂一个 Target 让 CopyEmbeddedPython 在 publish 完成后也跑一次，
    把 python-runtime 复制到最终的 publish 输出目录。
  -->
  <Target Name="CopyEmbeddedPythonToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_EmbeddedPythonPublishDir Condition="'$(PublishDir)' != ''">$(PublishDir)</_EmbeddedPythonPublishDir>
      <_EmbeddedPythonPublishDir Condition="'$(PublishDir)' == ''">$(OutDir)</_EmbeddedPythonPublishDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedPythonPublishDir)python-runtime" Condition="!Exists('$(_EmbeddedPythonPublishDir)python-runtime')" />
    <Copy SourceFiles="@(_EmbeddedPython)"
          DestinationFiles="@(_EmbeddedPython->'$(_EmbeddedPythonPublishDir)python-runtime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS_APP_SDK_SELF_CONTAINED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- PublishTrimmed 仅在 SelfContained=true 时有效，非独立发布时禁用 -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PRIResource Remove="Output\**" />
  </ItemGroup>
</Project>
