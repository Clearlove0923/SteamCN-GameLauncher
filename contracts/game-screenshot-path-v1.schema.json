{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamcn-game-launcher.local/contracts/game-screenshot-path-v1.schema.json",
  "title": "SteamCN Game Launcher screenshot path envelope",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "requestId", "gameId", "screenshotPath", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "screenshotPath": { "type": ["string", "null"] },
    "errors": { "type": "array" }
  }
}
